# Application Environment
VITE_NODE_ENV=development

# API Configuration
VITE_SERVER=/api
VITE_API_PROXY_URL=https://stage.seritaclinic.ir/api/
VITE_BASE_URL=https://panel.seritaclinic.ir

# my-teeth User Application URL
VITE_MY_TEETH_URL=https://my.seritaclinic.ir

# Application Version (for GlitchTip releases)
# Update this with each release for better error tracking
VITE_APP_VERSION=2.7.0

# GlitchTip Configuration
# DSN - Data Source Name (required for error tracking)
# Found in GlitchTip under Project Settings
VITE_GLITCHTIP_DSN=https://your-public-key@glitchtip.example.com/project-id

# GlitchTip Server URL
VITE_GLITCHTIP_URL=https://glitchtip.example.com/

# Performance monitoring sample rate (0.0 - 1.0)
# Keep it low in production so GlitchTip storage stays manageable
VITE_GLITCHTIP_TRACES_SAMPLE_RATE=0.01

# --- Source map upload (CI only) -------------------------------------------
# The three variables below are only read at build time by vite.config.js.
# When VITE_GLITCHTIP_AUTH_TOKEN is empty, source maps are not generated at all
# and no upload is attempted - the app still reports errors, just with
# minified stack traces.

# Auth Token - required for source map upload (keep secret, inject via CI!)
# Get from: GlitchTip > Profile > Auth Tokens
# Required scopes: project:write, project:releases
VITE_GLITCHTIP_AUTH_TOKEN=

# GlitchTip Organization slug
VITE_GLITCHTIP_ORG=your-org-slug

# GlitchTip Project slug
VITE_GLITCHTIP_PROJECT=your-project-slug

# Build Time (optional, automatically set during build)
VITE_BUILD_TIME=

# Notes:
# - Never commit .env files with real credentials to version control
# - Use different GlitchTip projects for development/staging/production
# - VITE_GLITCHTIP_AUTH_TOKEN is only needed for CI/CD and production builds
# - VITE_APP_VERSION should match your package.json version

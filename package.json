    "axios": "^1.4.0",
    "pinia": "^3.0.4",
    "quasar": "^2.18.6",
    "vue": "^3.5.25",
    "vue-easy-lightbox": "^1.19.0",
    "vue-router": "^4.2.4",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.9.0",
    "@sentry/vite-plugin": "^2.23.1",
